# Copy to .env.local for local development. Never commit .env.local.
# Every key here must also be declared in src/env.ts, or the build fails.

# Which deployment this is: local | preview | production
NEXT_PUBLIC_APP_ENV=local

# Public origin of this deployment (auth redirects, absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Added in PR 3 (database) ---
# Pooled Postgres connection string from Supabase (staging project for local dev).
# PRODUCTION VALUES ARE SET ONLY IN VERCEL, never in a file.
# DATABASE_URL=

# --- Added in PR 5 (auth) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ALLOWED_EMAILS=daniel@globalventures.app
