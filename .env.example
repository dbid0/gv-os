# Copy to .env.local for local development. Never commit .env.local.
# Every key here must also be declared in src/env.ts or src/env.schema.ts,
# or the build fails.

# Which deployment this is: local | preview | production
NEXT_PUBLIC_APP_ENV=local

# Public origin of this deployment (auth redirects, absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Local and preview point at the STAGING Supabase project.
# Production values are set ONLY in Vercel, never in a file.
#
# Two connection modes, and the difference matters:
#   DATABASE_URL           transaction pooler, port 6543 - app runtime
#                          (serverless-safe; requires prepare: false)
#   MIGRATION_DATABASE_URL session pooler,     port 5432 - migrations and scripts
#                          (DDL through the transaction pooler is unreliable, and
#                           Supabase's direct host is IPv6-only)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Added in PR 5 (auth) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ALLOWED_EMAILS=daniel@globalventures.app

# --- Workspace uploads (Supabase Storage) ---
# Server-only service-role key. When set, the workspace upload route creates the
# `workspace-uploads` bucket and streams attachments with admin rights (bypasses
# RLS — NEVER expose to the browser). If unset, uploads fall back to the signed-in
# user's anon client and require the bucket + policies in
# drizzle/manual/0001_workspace_uploads_bucket.sql.
# SUPABASE_SERVICE_ROLE_KEY=
